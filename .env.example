# ==============================================================================
# Tasty Bites Mobile POS - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
#
# IMPORTANT SECURITY NOTE:
# In React Native, environment variables are baked directly into the compiled
# JavaScript bundle at build time. NEVER put private server secrets, database
# passwords, or secret API keys in this file. Only public client configuration
# belongs here.
# ==============================================================================

# Backend API & WebSocket Server URL
# - Android Emulator: http://10.0.2.2:3000
# - iOS Simulator:    http://localhost:3000
# - Physical Tablet:  http://<your-lan-ip>:3000 (e.g. http://192.168.1.100:3000)
# - Production:       https://pos.tastybitesrestaurant.com
API_BASE_URL=http://10.0.2.2:3000

# Application Branding
APP_NAME=Tasty Bites
APP_SUBTITLE=SALES POS

# Default Raw Network Thermal Printer Port (ESC/POS TCP)
DEFAULT_PRINTER_PORT=9100
